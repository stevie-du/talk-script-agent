# 运行时输出
generated/

# 「导出为 Agent 技能」的产物目录：**是生成物，不是源码**。
# 之前被跟踪进仓库，于是它与 packs/elevator 逐渐漂移（skill.yaml 已经不一致），
# 还带着一份 private/ 目录，和「默认不导出私有资料」的策略相矛盾。
# 需要时在界面点一次「导出为 Agent 技能」即可重新生成。
agent-skills/

# Electron 打包产物
desktop/dist*/
desktop/dist/
desktop/release/

# node
node_modules/

# 系统/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 本地工具目录（agent 工作记忆 / 计划）
.workbuddy/
.zcode/

# 本地界面截图产物与临时验证脚本
_shots/
_shot*.js
_probe.js
_check.js
_expr.js
_final.js

# 无头 Chrome 调试用临时 Profile
_cprof*/
_chrome-profile/
_verify/_cprof/

# UI 验证截图产物（脚本 _verify/verify.js 保留，便于回归自测）
_verify/*.png

# 一次性排查脚本的运行产物与临时批处理
# 约定：_verify/ 下**下划线开头**的都是临时件（截图、排查脚本、运行日志、临时 profile），
# 正式工具与有意保留的目录不带下划线（verify.js / e2e-live.js / shot-live.js /
# who-locks.js / ink-measure.js / csp-probe.js / lib/ / legacy/）。
#
# 原来这里按扩展名一条条列（`_*.txt` / `_*.log` / `_*.js` / `_app.log` / `_start.bat`），
# **每冒出一类新临时件就要回来补一条** —— `_net_probe.py` / `_scan_trace.py` 两个
# 临时 py 就是这么漏掉的（P2-4）。按扩展名列举永远追不上新写法，
# 所以改成「下划线开头 + 任意扩展名」一把覆盖。
# 已核对：_verify/ 下**没有**任何已跟踪文件以下划线开头，`git add -A` 不会误伤。
_verify/_*

# 本地配置：含明文 API Key，绝不入库（模板见 config.example.yaml）
config.yaml
# WorkBuddy 会话与记忆数据（非源码，不入库）
.workbuddy-ai/
